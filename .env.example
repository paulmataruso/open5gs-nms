# ═══════════════════════════════════════════════════════════
# Open5GS NMS - Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and customize for your deployment
# Do NOT commit .env to version control (contains secrets)

# ───────────────────────────────────────────────────────────
# Network / Access
# ───────────────────────────────────────────────────────────
# The external IP or hostname users will access the app from.
# Informational only - used for reference in docs/scripts.
NMS_HOST=127.0.0.1

# Nginx listen port (web UI access)
NGINX_PORT=8888

# ───────────────────────────────────────────────────────────
# Backend Configuration
# ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# ───────────────────────────────────────────────────────────
# Database Configuration
# ───────────────────────────────────────────────────────────
# MongoDB connection string for Open5GS subscriber database
# NOTE: This is the Open5GS MongoDB instance - do not point
# this at a separate database. NMS auth uses its own SQLite DB.
MONGODB_URI=mongodb://127.0.0.1:27017/open5gs

# ───────────────────────────────────────────────────────────
# Open5GS Paths
# ───────────────────────────────────────────────────────────
# Path to Open5GS configuration files
CONFIG_PATH=/etc/open5gs

# Path to store configuration backups
BACKUP_PATH=/etc/open5gs/backups/config

# Path to store MongoDB backups
MONGO_BACKUP_PATH=/etc/open5gs/backups/mongodb

# ───────────────────────────────────────────────────────────
# Authentication
# ───────────────────────────────────────────────────────────
# Path inside the container where auth.db (SQLite) is stored.
# Must match the ./data:/app/data volume mount in docker-compose.yml.
# The NMS creates and manages this file automatically.
AUTH_DB_PATH=/app/data/auth.db

# Session lifetime in seconds (default: 86400 = 24 hours)
SESSION_MAX_AGE=86400

# Set this on first deploy to control the initial admin password.
# If left empty, a random password is generated and printed once
# to the backend container logs - check with:
#   docker logs open5gs-nms-backend 2>&1 | grep -A4 "FIRST RUN"
# Clear or remove this variable after your first login.
FIRST_RUN_PASSWORD=

# Set to 'true' ONLY when the app is served over HTTPS.
# Enabling this on plain HTTP will silently break login (browser won't store the cookie).
# Default: false (HTTP deployments work out of the box)
COOKIE_SECURE=false

# ───────────────────────────────────────────────────────────
# WebSocket Configuration
# ───────────────────────────────────────────────────────────
# Port for WebSocket server (real-time log streaming)
WS_PORT=3002

# ───────────────────────────────────────────────────────────
# Internal Service Ports
# ───────────────────────────────────────────────────────────
# BACKEND_PORT and FRONTEND_PORT are internal container-to-container
# ports — they are never exposed to the outside world.
#
# What you actually connect to:
#   http://YOUR_SERVER_IP:8888  — everything (web UI + API)
#   http://YOUR_SERVER_IP:8094  — SASBench admin UI (the CBRS SAS)
#
# The SAS protocol ports (8899 HTTP / 8443 HTTPS) belong to SASBench, which
# binds them itself. nginx is NOT in that path — see the CBRS SAS section.
#
# Port 8888 is nginx, which internally proxies to:
#   FRONTEND_PORT (8081) — the React frontend server
#   BACKEND_PORT  (3001) — the Node.js API server
#
# Only change these if you have a port conflict on the host,
# and update docker-compose.yml + nginx.conf to match.
BACKEND_PORT=3001
FRONTEND_PORT=8081

# ───────────────────────────────────────────────────────────
# CBRS SAS — SASBench
# ───────────────────────────────────────────────────────────
# The Spectrum Access System is SASBench, which runs as its own container and
# binds the SAS-CBSD protocol ports DIRECTLY. Nothing in this stack sits in
# front of it: no nginx location, no proxy, no TLS termination. Radios connect
# to SASBench, and what it logs is what the radio actually sent.
#
# SASBench is a separate repository and is deliberately NOT vendored into this
# AGPL-3.0 project. You do not need to clone it: the sasbench service builds
# from a remote git context pinned to a commit, so
# `docker compose build && docker compose up -d` brings the SAS up on a host
# with nothing cloned.
#
# Both settings below are optional and are commented out on purpose. Leave
# them alone unless you are developing SASBench itself.

# What the sasbench image is built from. The default is the exact SASBench
# revision this NMS release was tested against, which is why it is a commit
# rather than a branch: two hosts building a week apart otherwise run
# different SAS code while real radios hold grants from it. The SAS page
# reports when upstream has moved past the pin, and its Update button rebuilds
# at upstream's current commit.
#
# Point this at a local checkout to build from a working copy instead:
#   SASBENCH_CONTEXT=/opt/sasbench
# SASBENCH_CONTEXT=https://github.com/paulmataruso/SASBench.git#<commit>

# An optional SASBench checkout on the host. Nothing requires it to exist;
# when it does, the SAS page reports commit-level detail from it.
# SASBENCH_DIR=/opt/sasbench

# SAS-CBSD protocol ports. These are the ports radios are pointed at.
#   SAS_HTTP_PORT  — plain HTTP
#   SAS_HTTPS_PORT — HTTPS / mutual TLS (WINNF-TS-0065)
# SASBench matches the protocol path anywhere in the URL, so a radio already
# configured for .../sas/v1.2/registration keeps working unchanged.
SAS_HTTP_PORT=8899
SAS_HTTPS_PORT=8443

# SASBench's own admin UI and REST API (/api/v1). The NMS reads this to render
# its SAS status page and dashboard card, and links here for anything that
# changes SAS state. NOT 8080: PyHSS already binds 127.0.0.1:8080 on this host.
SASBENCH_UI_PORT=8094

# Settings profile: lab | winnforum | open. Applied on the first start and
# again whenever this value changes.
#
# Keep this at `lab` unless you know what you are changing. `winnforum` sets
# tlsClientAuth=require (every radio then needs a SASBench-issued client
# certificate) and acceptVersionlessPaths=false (which rejects radios that
# send a malformed protocol path — there are such radios on this deployment).
# Either one drops live radios off the SAS the moment it is applied.
SAS_PROFILE=lab
# Set to "always" to re-apply SAS_PROFILE on every start, undoing any change
# made in SASBench's own Settings page. Normally left empty.
SAS_PROFILE_APPLY=

# Password for SASBench's "admin" account, read only on its FIRST start
# (change it afterwards in SASBench itself). The NMS backend also uses it to
# read the REST API server-side — it is never sent to the browser.
SAS_ADMIN_PASSWORD=

# The FQDN or IP radios use to reach the SAS. Becomes the CN and first SAN of
# SASBench's auto-generated server certificate. The host's own interface
# addresses are always included, so this is only needed for a name or a NAT
# address. Optional.
SAS_FQDN=
# Extra names/addresses for that certificate, comma-separated. Optional.
SAS_HOSTNAMES=
# Bind every SASBench listener to one address instead of all of them. Optional.
SAS_BIND_IP=
# Set to "off" to disable sign-in on SASBench's UI and REST API entirely.
# Only for an isolated bench. The SAS protocol ports never ask for sign-in.
SAS_AUTH=
# Browser origins allowed to call SASBench's REST API cross-site. Optional.
SAS_API_CORS_ORIGINS=

# ───────────────────────────────────────────────────────────
# System Integration
# ───────────────────────────────────────────────────────────
# Path to systemctl binary on host system
HOST_SYSTEMCTL_PATH=/usr/bin/systemctl

# ───────────────────────────────────────────────────────────
# Monitoring (Prometheus + Grafana)
# ───────────────────────────────────────────────────────────
# Grafana admin credentials (set before first docker compose up)
# Defaults: admin / open5gs
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=open5gs

# Prometheus port (default 9099 — NOT 9090, which Open5GS NFs already use for metrics)
PROMETHEUS_PORT=9099

# Grafana port (default 3000)
GRAFANA_PORT=3000

# Prometheus config path (relative to project root) — auto-updated by NMS on apply
PROMETHEUS_CONFIG_PATH=./monitoring/prometheus.yml

# Prometheus base URL used by backend to trigger live reload
# Defaults to http://127.0.0.1:${PROMETHEUS_PORT} if not set
# PROMETHEUS_URL=http://127.0.0.1:9099

# Access:
#   Prometheus: http://YOUR_SERVER_IP:${PROMETHEUS_PORT}
#   Grafana:    http://YOUR_SERVER_IP:${GRAFANA_PORT}

# ───────────────────────────────────────────────────────────
# UI Module Toggles
# ───────────────────────────────────────────────────────────
# Enable/disable optional UI modules — hides them from the nav sidebar and
# disables their page entirely. true/false only.
# NOTE: these are baked into the frontend at build time — changing them
# requires: docker compose build frontend && docker compose up -d frontend
ENABLE_SMS_MODULE=true
ENABLE_IMS_MODULE=true
ENABLE_VALIDATION_MODULE=true
ENABLE_VOWIFI_MODULE=true
ENABLE_DNS_MIGRATION_MODULE=true
ENABLE_PCAP_MODULE=true
# Defaults to false, unlike every other module above — this is the first
# module where a bug/misconfiguration can cause real-world billing on a
# linked SIP trunk account, not just a broken lab feature. Opt in explicitly.
ENABLE_PSTN_MODULE=false
# Also defaults to false — MMS depends on VectorCore MMSC, a third-party
# binary built from source and run as a host service, not just a config
# toggle. Opt in explicitly once you've reviewed it. Shows as a tab on the
# SMS page (SMS/MMS) rather than its own nav entry.
ENABLE_MMS_MODULE=false
# Also defaults to false — same reasoning as MMS: a third-party binary
# (VectorCore SMSC) built from source and run as a host service. A third
# SMS Delivery Mode option alongside SMS-over-IMS and SMS-over-SGs, shown as
# its own tab on the SMS page.
ENABLE_VECTORCORE_SMSC_MODULE=false
# Also defaults to false — misconfiguring this module risks a live radio's
# real S1/N2 backhaul (it terminates IPsec tunnels from real eNodeB/gNodeB
# hardware), a bigger blast radius than a broken lab feature. Opt in explicitly.
ENABLE_SECGW_MODULE=false
# Also defaults to false — real 2G GSM (BSC/BTS on top of the SMS-over-SGs
# module's already-running osmo-hlr/osmo-msc/osmo-stp). Same posture as
# SecGW: misconfiguring live radio is a bigger blast radius than a broken
# lab feature. A real BTS (SDR or dedicated hardware) also needs actual
# spectrum authorization in virtually every jurisdiction — see the module's
# own Setup tab before enabling real transmission.
ENABLE_GSM_MODULE=false
# Also defaults to false — a second, fully isolated Asterisk instance (own
# config tree, own systemd unit, own loopback IP) dedicated to real 2G-to-2G
# internal voice calling, shown as a tab on the GSM page. Never touches the
# separate Asterisk instance PSTN Gateway owns.
ENABLE_ASTERISK_2G_MODULE=false
# Also defaults to false — 3G/UMTS via OsmoHNBGW, source-built (not an apt
# package) against this host's actual installed Osmocom libraries. Adds a new
# cs7/IuPS block to the 2G module's own osmo-sgsn.cfg (via ownership-merge,
# never a blind overwrite) and a third, dedicated OsmoMGW instance. Needs a
# real HNB (e.g. an ip.access nano3G) or OsmoHNodeB (a software test HNB,
# deployable from the module's own page) to actually attach anything.
ENABLE_HNBGW_MODULE=false
# Also defaults to false — SigScale OCS (Online Charging System), a real,
# separate Erlang/OTP application installed via its own apt package. Wires a
# Diameter Gy peer into Open5GS's core SMF (which has supported Gy natively
# since v2.4.7) for real-time 4G/EPC credit-control charging. 4G/EPC only —
# Open5GS's SMF has no 5G online-charging (Nchf) client upstream, so 5G NR
# sessions are never covered. Touches SMF's own freeDiameter peer list (one
# exclusively-owned ConnectPeer line, alongside VoWiFi's own S6b line if that
# module is also installed) — same caution class as other modules that touch
# an always-on core NF's config.
ENABLE_OCS_MODULE=false
# Also defaults to false — unified Call Detail Records across PSTN/2G/IMS.
# Phase 1/2 (Asterisk CDR CSV ingestion) is low-risk read-only file tailing;
# Phase 3 (Kamailio acc module for direct IMS calls) touches a live core IMS
# component, same caution class as ocs/pstn/gsm.
ENABLE_CDR_MODULE=false
# Also defaults to false — compiles a small Go program against a third-party
# module (github.com/ncode/twamp) at Install time. TWAMP (RFC 5357) reflector
# testing — real backhaul RTT/jitter/one-way-delay/packet-loss, e.g. against
# a Nokia AirScale radio's built-in reflector.
ENABLE_TWAMP_MODULE=false
# Also defaults to false — ALPHA STAGE, actively being built out. LTE RF
# coverage/link-budget planning tool (deterministic propagation engine —
# not yet the full multi-phase tool described in its own design doc).
# Expect rough edges, incomplete phases, and possible breaking changes
# between releases. Opt in only if you want to test it early.
ENABLE_RF_PLANNING_MODULE=false
# Defaults to true (like sms/ims/validation) — new, community-contributed
# "UE Signal" page: per-UE RSRP/RSRQ/SINR/BLER/MCS/CQI/throughput correlated
# with subscriber identity (IMSI/ICCID/MSISDN). Native connector is
# Baicells-specific today; other vendors need the generic JSON connector,
# which requires the radio to expose its own metrics in that shape — not a
# drop-in for every vendor. Set to false to hide it.
ENABLE_UE_SIGNAL_MODULE=true
# Also defaults to false — installs snmpd (a real host service) and opens
# UDP/161 for a read-only SNMPv2c monitoring agent (PRTG and similar). Not
# just a config toggle: it changes what's listening on the host network.
ENABLE_SNMP_MODULE=false

# ───────────────────────────────────────────────────────────
# GenieACS (TR-069 ACS)
# ───────────────────────────────────────────────────────────
# Secret used to sign GenieACS UI session JWTs.
# Change this to a long random string before deploying.
# Generate one with: openssl rand -hex 32
GENIEACS_UI_JWT_SECRET=changeme_set_this_to_a_long_random_string

# GenieACS UI port (default 7000 — port 3000 is used by Grafana)
GENIEACS_UI_PORT=7000

# Access:
#   GenieACS UI:   http://YOUR_SERVER_IP:7000
#   CWMP (TR-069): http://YOUR_SERVER_IP:7547  <- point CPEs here
#   NBI (API):     http://YOUR_SERVER_IP:7557
#   FS (files):    http://YOUR_SERVER_IP:7567
# MongoDB DB used: genieacs  (separate from open5gs DB)
GENIEACS_MONGODB_CONNECTION_URL=mongodb://127.0.0.1:27017/genieacs

# ───────────────────────────────────────────────────────────
# Simlessly eSIM RSP API (Subscribers page — "Generate eSIM")
# ───────────────────────────────────────────────────────────
# Get these from the Developer module on your Simlessly account
# (https://docs.simlessly.com). Leave empty to disable live eSIM
# generation — the JSON preview/copy still works without them, only
# the "Generate via Simlessly API" button requires real credentials.
SIMLESSLY_ACCESS_KEY=
SIMLESSLY_SECRET_KEY=
# Radio Signal page — reference this variable name when adding a Baicells radio.
# Create one variable per credential when radios do not share the same password.
BAICELLS_RADIO_PASSWORD=
# 32+ random characters used to encrypt each radio's individual password.
RADIO_CREDENTIALS_KEY=
