diff --git a/eigrpd/eigrp_topology.c b/eigrpd/eigrp_topology.c
index e59dcac..1d75134 100644
--- a/eigrpd/eigrp_topology.c
+++ b/eigrpd/eigrp_topology.c
@@ -506,6 +506,152 @@ void eigrp_topology_neighbor_down(struct eigrp *eigrp,
 	eigrp_update_send_all(eigrp, nbr->ei);
 }
 
+/*
+ * NMS: find — and optionally remove — route descriptors that still name `nbr`
+ * as their advertising router.
+ *
+ * Why this is needed. eigrp_topology_neighbor_down() above does NOT delete a
+ * dead neighbour's descriptors; it hands each one to DUAL as a max-metric
+ * update and relies on the resulting state transition to remove it.
+ * eigrp_nbr_delete() then frees the neighbour unconditionally. Any descriptor
+ * whose removal transition did not happen is therefore left holding a
+ * dangling adv_router, which:
+ *
+ *   - show_ip_eigrp_route_descriptor() dereferences (te->adv_router->src),
+ *     printing whatever the freed allocation now contains — the "via
+ *     <changing garbage>" signature, and
+ *   - DUAL reads again on the next recompute, where it can be counted as a
+ *     successor and installed into zebra as a nexthop with no address.
+ *
+ * A skipped transition is not hypothetical here: this deployment carries a
+ * crash-guard for frr#943 that deliberately skips the FSM transition when a
+ * prefix has no feasible successor, which is precisely the transition that
+ * would have removed the descriptor.
+ *
+ * `purge` false logs without changing anything (the Phase 0 probe); true
+ * removes the descriptor and recomputes the prefix through the stock path, so
+ * a prefix that loses its last entry is withdrawn from zebra rather than left
+ * installed.
+ */
+/*
+ * NMS: re-issue every prefix's zebra route.
+ *
+ * Fixes a second, separate failure mode measured on this deployment: after the
+ * transit interface flaps, zebra keeps the EIGRP route in its RIB but never
+ * installs it into the kernel ("Status: Changed", "Flags: None", and no kernel
+ * route at all), because the nexthop object it still points at lost its
+ * gateway while the link was down — `ip nexthop show` reads
+ * "id N dev <if> scope host" with NO via address. That is the same via-less
+ * nexthop signature this deployment has seen blackhole live radio traffic.
+ *
+ * The peer re-advertises nothing on the way back up and the recomputed metric
+ * is unchanged, so DUAL never re-issues the route and zebra is never asked
+ * again. Forcing one re-add when an adjacency reaches full state builds a
+ * fresh nexthop and the route installs; measured as the difference between a
+ * missing route and "Flags: Selected, Status: Installed".
+ *
+ * Idempotent by construction: it only re-states routes EIGRP already owns,
+ * through the same stock path DUAL uses, so a healthy table is unchanged.
+ */
+void eigrp_topology_refresh_routing_table(struct eigrp *eigrp)
+{
+	struct eigrp_prefix_descriptor *pe;
+	struct route_node *rn;
+
+	for (rn = route_top(eigrp->topology_table); rn; rn = route_next(rn)) {
+		pe = rn->info;
+		if (!pe)
+			continue;
+
+		eigrp_topology_update_node_flags(eigrp, pe);
+		eigrp_update_routing_table(eigrp, pe);
+	}
+}
+
+unsigned int eigrp_topology_neighbor_purge(struct eigrp *eigrp,
+					   struct eigrp_neighbor *nbr,
+					   bool purge)
+{
+	struct listnode *node, *nnode;
+	struct eigrp_prefix_descriptor *pe;
+	struct eigrp_route_descriptor *entry;
+	struct route_node *rn;
+	unsigned int found = 0;
+
+	for (rn = route_top(eigrp->topology_table); rn; rn = route_next(rn)) {
+		pe = rn->info;
+		if (!pe)
+			continue;
+
+		bool touched = false;
+
+		/*
+		 * Pass 1: neutralise, do not remove.
+		 *
+		 * Removing the descriptor outright was tried and is wrong: the
+		 * peer re-advertises nothing after an interface flap, so the
+		 * prefix is lost for good (measured: 29 prefixes -> 13 on this
+		 * deployment's transit link, with no recovery short of
+		 * restarting frr). Keeping the descriptor and clearing the
+		 * dangling pointer fixes the use-after-free without discarding
+		 * topology state the peer will not resend.
+		 *
+		 * EIGRP_MAX_METRIC is what makes it inert, using the daemon's
+		 * own existing rules rather than a new special case:
+		 * eigrp_topology_update_node_flags() will not flag a
+		 * max-metric entry as a successor, and
+		 * show_ip_eigrp_route_descriptor() returns early on one, so it
+		 * neither reaches zebra nor prints.
+		 */
+		for (ALL_LIST_ELEMENTS(pe->entries, node, nnode, entry)) {
+			if (entry->adv_router != nbr)
+				continue;
+
+			found++;
+			zlog_warn("EIGRP AS: %u %pFX still references neighbour %pI4 after DUAL teardown%s (NMS dangling-adv_router)",
+				  eigrp->AS, &pe->destination, &nbr->src,
+				  purge ? " - neutralising" : "");
+
+			if (!purge)
+				continue;
+
+			entry->adv_router = NULL;
+			entry->reported_distance = EIGRP_MAX_METRIC;
+			entry->distance = EIGRP_MAX_METRIC;
+			entry->flags &= ~EIGRP_ROUTE_DESCRIPTOR_SUCCESSOR_FLAG;
+			entry->flags &= ~EIGRP_ROUTE_DESCRIPTOR_FSUCCESSOR_FLAG;
+			entry->flags &= ~EIGRP_ROUTE_DESCRIPTOR_INTABLE_FLAG;
+			touched = true;
+		}
+
+		if (!touched)
+			continue;
+
+		/*
+		 * Pass 2: keep at most one inert descriptor per prefix, so
+		 * repeated adjacency churn cannot grow the table without
+		 * bound. Never take the last entry: an empty prefix is the
+		 * prefix loss pass 1 exists to avoid.
+		 */
+		unsigned int inert = 0;
+
+		for (ALL_LIST_ELEMENTS(pe->entries, node, nnode, entry)) {
+			if (entry->adv_router)
+				continue;
+			inert++;
+			if (inert == 1 || pe->entries->count <= 1)
+				continue;
+			listnode_delete(pe->entries, entry);
+			XFREE(MTYPE_EIGRP_ROUTE_DESCRIPTOR, entry);
+		}
+
+		eigrp_topology_update_node_flags(eigrp, pe);
+		eigrp_update_routing_table(eigrp, pe);
+	}
+
+	return found;
+}
+
 void eigrp_update_topology_table_prefix(struct eigrp *eigrp,
 					struct route_table *table,
 					struct eigrp_prefix_descriptor *prefix)
