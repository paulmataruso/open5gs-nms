diff --git a/eigrpd/eigrp_neighbor.c b/eigrpd/eigrp_neighbor.c
index 8024934..035be52 100644
--- a/eigrpd/eigrp_neighbor.c
+++ b/eigrpd/eigrp_neighbor.c
@@ -170,9 +170,27 @@ struct eigrp_neighbor *eigrp_nbr_lookup_by_addr_process(struct eigrp *eigrp,
 void eigrp_nbr_delete(struct eigrp_neighbor *nbr)
 {
 	eigrp_nbr_state_set(nbr, EIGRP_NEIGHBOR_DOWN);
-	if (nbr->ei)
+	if (nbr->ei && !nbr->ei->eigrp->finishing) {
 		eigrp_topology_neighbor_down(nbr->ei->eigrp, nbr);
 
+		/*
+		 * DUAL above is not guaranteed to have removed every descriptor
+		 * naming this neighbour, and the XFREE below makes any survivor
+		 * a dangling pointer. See eigrp_topology_neighbor_purge().
+		 *
+		 * Unconditional, on every path that frees a neighbour. An
+		 * earlier version ran only while the interface stayed
+		 * operative, to avoid the prefix loss that removing
+		 * descriptors caused on a flap. That left the flap's own
+		 * descriptors dangling, and a later adjacency loss then
+		 * surfaced them as corruption anyway (measured: flap followed
+		 * by a clear gave 16 corrupt prefixes and three ECMP routes
+		 * for one destination). Neutralising instead of removing makes
+		 * the narrowing unnecessary.
+		 */
+		eigrp_topology_neighbor_purge(nbr->ei->eigrp, nbr, true);
+	}
+
 	/* Cancel all events. */ /* Thread lookup cost would be negligible. */
 	event_cancel_event(master, nbr);
 	eigrp_fifo_free(nbr->multicast_queue);
