+static void fill_scope_tais(SBcAP_List_of_TAIs_t *list,const struct cbc_message *m)
+{
+    unsigned int i;
+    for(i=0;i<m->num_scope_tais;i++) {
+        struct SBcAP_List_of_TAIs__Member *t=CALLOC(1,sizeof(*t));
+        t->tai.pLMNidentity.buf=MALLOC(3);t->tai.pLMNidentity.size=3;
+        osmo_plmn_to_bcd(t->tai.pLMNidentity.buf,&m->scope_tais[i].plmn);
+        t->tai.tAC.buf=MALLOC(2);t->tai.tAC.size=2;
+        osmo_store16be(m->scope_tais[i].tac,t->tai.tAC.buf);
+        ASN_SEQUENCE_ADD(&list->list,t);
+    }
+}
