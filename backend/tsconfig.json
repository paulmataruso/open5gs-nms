{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "baseUrl": "./src",
    "paths": {
      "@domain/*": ["domain/*"],
      "@application/*": ["application/*"],
      "@infrastructure/*": ["infrastructure/*"],
      "@interfaces/*": ["interfaces/*"],
      "@config/*": ["config/*"]
    }
  },
  "include": ["src/**/*"],
  // Test files are deliberately NOT emitted. They were previously compiled into
  // dist/ (unused by anything — nothing imports a test), and leaving them in the
  // production compile also meant a test could not reach outside rootDir even
  // though it never ships: ran-radio-grouping.test.ts executes the RAN page's
  // pure grouping module, which lives in frontend/src and is not present in the
  // backend image's build context at all.
  "exclude": ["node_modules", "dist", "src/**/__tests__/**", "src/**/*.test.ts"]
}
